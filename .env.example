# Copy this file to .env and fill in values locally.
# NEVER commit .env. NEVER paste secrets into chat, issues or logs.

# --- Trading 212 credentials (Trading 212 app -> Settings -> API) ---
# API key. Start with a DEMO key with read-only scopes (account, portfolio, metadata, orders:read, history:*).
T212_API_KEY=
# API secret. Shown once by Trading 212 when the key is created.
T212_API_SECRET=

# --- Account identity checks (the bot refuses to start if these do not match the broker) ---
# INVEST or ISA only. Anything else (CFD, SIPP, blank) => the bot refuses to run.
ACCOUNT_TYPE=INVEST
# Numeric account id shown in the Trading 212 app; compared with /equity/account/summary "id".
T212_EXPECTED_ACCOUNT_ID=
# Must equal the "currency" returned by /equity/account/summary.
ACCOUNT_BASE_CURRENCY=GBP

# --- Mode safety: live needs BOTH TRADING_MODE=LIVE and ENABLE_LIVE_TRADING=YES ---
# PAPER (default, uses demo.trading212.com) or LIVE.
TRADING_MODE=PAPER
# Must be exactly YES (together with TRADING_MODE=LIVE) for live orders; anything else => paper.
ENABLE_LIVE_TRADING=NO
# true => compute and log orders but never send them to any broker (not even demo).
DRY_RUN=true

# --- Emergency control ---
# true => no new orders; existing protective stops stay in place; monitoring continues.
KILL_SWITCH=false

# --- Market data provider (chosen in Phase 2) ---
# e.g. norgate | sharadar | yfinance  (yfinance is survivorship-biased: research prototyping only)
MARKET_DATA_PROVIDER=
# Provider API key, if the provider needs one.
MARKET_DATA_API_KEY=
